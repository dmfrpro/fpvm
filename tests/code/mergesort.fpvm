# Add Integer division and remainder to std (intdiv, intrem)
# divide always return real

(func isempty (lst) (cond (isnull lst) (true) (isnull (head lst))))

(
    func take (n lst) (
        cond (isempty lst) (null) (
            cond (equal n 0) (null) (
                cons (head lst) (take (minus n 1) (tail lst))
            )
        )
    )
)

(
    func drop (n lst) (
        cond (isempty lst) (lst) (
            cond (equal n 0) (lst) (
                drop (minus n 1) (tail lst)
            )
        )
    )
)

(
    func merge (lhs rhs) (
        cond (isempty lhs) (rhs) (
            cond (isempty rhs) (lhs) (
                cond (less (head lhs) (head rhs))
                    (cons (head lhs) (merge (tail lhs) rhs))
                    (cons (head rhs) (merge lhs (tail rhs)))
            )
        )
    )
)

(
    func leftsplit (lst) (
        take (divide (length lst) 2) lst
    )
)

(
    func rightsplit (lst) (
        drop (divide (length lst) 2) lst
    )
)

(
    func mergesort (lst) (
        cond (not (islist lst)) (null) (
            cond (lesseq (length lst) 1) (lst) (
                merge (mergesort (leftsplit lst)) (mergesort (rightsplit lst))
            )
        )
    )
)

(mergesort (quote (1 4 1 6 7 5 15))) # '(1 1 4 5 6 7 15)
