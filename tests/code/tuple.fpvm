(func tuple (a b) (cons a (cons b null)))
(func first (t) (head t))
(func second (t) (head (tail t)))

# Tests
(setq testtuple (tuple 1 true))
(first testtuple)   # 1
(second testtuple)  # true

(setq testtriple (tuple 1.4 (tuple 1 2)))
(first testtriple) # 1.4
(second testtriple) # (tuple 1 2)
(first (second testtriple)) # 1
(second (second testtriple)) # 2
