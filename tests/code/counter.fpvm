(func tuple (a b) (cons a (cons b null)))
(func first (t) (head t))
(func second (t) (head (tail t)))
(func isempty (lst) (cond (isnull lst) (true) (isnull (head lst))))

(
    func addelement (res value) (
        cond (isempty res) (cons (tuple value 1) null) (
            prog (x xs)
                (
                (setq x (head res))
                (setq xs (tail res))
                (return (cond (equal (first x) value) (cons (tuple value (plus (second x) 1)) xs)
                              (cons x (addelement xs value))))
                )
        )
    )
)

(
    func counthelper (lst res) (
         cond (isempty lst) (res) (
            prog (x xs)
                (
                (setq x (head lst))
                (setq xs (tail lst))
                (return (counthelper xs (addelement res x)))
                )
         )
    )
)

(func count (lst) (counthelper lst '()))

# Test
(count '(1 1 1 3 2 4 5 1 1))  # *tuple* 1: 5, 3: 1, 2: 1, 4: 1, 5: 1 *Any order*
