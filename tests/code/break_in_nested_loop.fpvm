(prog (i)
    (
        (setq i 0)
        (while true
            (prog ()
                (
                    (setq i (plus i 1))
                    (while true
                        (break)
                    )
                    (cond (equal i 3)
                        (break)
                    )
                )
            )
        )
        i
    )
)
